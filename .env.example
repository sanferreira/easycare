# PostgreSQL database connection
DATABASE_URL=postgresql://postgres:password@localhost:5432/easycare

# Session secret (use a long random value in production)
SESSION_SECRET=change-me-with-a-long-random-secret

# Server port (optional)
PORT=5000

# Application timezone for clinical schedules
TZ=America/Sao_Paulo

# Auto generation of monthly contract fees (finance)
MONTHLY_FEES_AUTO_ENABLED=true
# Interval in minutes for background verification/generation
MONTHLY_FEES_AUTO_INTERVAL_MINUTES=180

# WhatsApp notifications (Meta WhatsApp Cloud API)
# Keep false unless the Meta app, phone number and approved template are configured.
WHATSAPP_NOTIFICATIONS_ENABLED=false
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_META_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Production should use an approved utility template with 2 body variables:
# {{1}} = notification title, {{2}} = notification message
WHATSAPP_MESSAGE_MODE=template
WHATSAPP_TEMPLATE_NAME=easycare_alerta
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
# For local tests inside an active customer-service window only:
# WHATSAPP_MESSAGE_MODE=text
WHATSAPP_DEFAULT_COUNTRY_CODE=55
WHATSAPP_WORKER_INTERVAL_SECONDS=60
WHATSAPP_WORKER_BATCH_SIZE=25
WHATSAPP_MAX_ATTEMPTS=3
WHATSAPP_LOOKBACK_MINUTES=1440
# Leave empty to send all supported time-clock notification types.
WHATSAPP_NOTIFICATION_TYPES=

# Web Push notifications (browser push)
# Generate keys with: npm run webpush:keys
WEB_PUSH_ENABLED=false
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# Must be a mailto: or https: contact for VAPID.
WEB_PUSH_SUBJECT=mailto:suporte@easycare.local
WEB_PUSH_WORKER_INTERVAL_SECONDS=30
WEB_PUSH_WORKER_BATCH_SIZE=50
WEB_PUSH_MAX_ATTEMPTS=3
WEB_PUSH_LOOKBACK_MINUTES=1440

# Medication notifications
MEDICATION_NOTIFICATIONS_ENABLED=true
MEDICATION_NOTIFICATION_WORKER_INTERVAL_SECONDS=60
MEDICATION_REMINDER_BEFORE_MINUTES=10
MEDICATION_OVERDUE_AFTER_MINUTES=15
